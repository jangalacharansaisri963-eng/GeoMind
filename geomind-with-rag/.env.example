# Copy this file to .env and fill in your own values.
# .env is already git-ignored — never commit real credentials.

# --- Google Programmable Search (optional) ---
# Powers GeoMind's live web research fallback for questions outside its
# local datasets. Works everywhere, including Termux (plain HTTPS request,
# no browser/Playwright needed).
#
# 1. Get an API key: https://console.cloud.google.com
#    -> APIs & Services -> Enable "Custom Search API" -> Credentials -> Create API Key
# 2. Create a search engine: https://programmablesearchengine.google.com
#    -> Create -> "Sites to search": leave as "Search the entire web"
#    -> copy the "Search engine ID" (this is GOOGLE_SEARCH_ENGINE_ID / cx)
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# --- Server (optional) ---
# PORT=3000
